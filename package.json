{
  "name": "core-academico",
  "version": "4.23.1",
  "description": "Core Académico con Gemini, calculadoras, notas rápidas y herramientas académicas",
  "main": "main.js",
  "author": "Core Académico",
  "license": "MIT",
  "private": true,

  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "web:prepare": "node scripts/prepare-web.js"
  },

  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@types/node": "^24.0.0",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2"
  },

  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0"
  },

  "build": {
    "appId": "com.coreacademico.app",
    "productName": "Core Académico",
    "asar": true,

    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "manifest.webmanifest",
      "sw.js",
      "icons/**/*",
      "capacitor.config.ts",
      "package.json"
    ],

    "directories": {
      "output": "dist"
    },

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon-512.png"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Core Académico"
    }
  }
}
